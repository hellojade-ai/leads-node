{
  "name": "@hellojade/intake",
  "version": "0.1.1",
  "description": "Node.js client for the hellojade Partner Intake API: submit leads with idempotency, retries and typed errors.",
  "license": "MIT",
  "author": "hellojade (https://hellojade.ai)",
  "homepage": "https://github.com/hellojade-ai/leads-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellojade-ai/leads-node.git"
  },
  "bugs": {
    "url": "https://github.com/hellojade-ai/leads-node/issues"
  },
  "keywords": ["hellojade", "intake", "leads", "lead-generation", "api-client", "typescript"],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('node:fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/client.test.mjs test/cjs.test.cjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.5.0"
  }
}
